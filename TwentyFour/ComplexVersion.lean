import TwentyFour.Main
import Mathlib.Data.Complex.Basic

namespace TwentyFour

abbrev SL2Complex := Matrix.SpecialLinearGroup (Fin 2) ℂ

/-- The first displayed generator, as an actual complex matrix. -/
def Acomplex : SL2Complex :=
  ⟨!![1, 0; 1, 1], by simp [Matrix.det_fin_two]⟩

/-- The second displayed generator, as an actual complex matrix. -/
def Bcomplex (q : ℂ) : SL2Complex :=
  ⟨!![1, q; 0, 1], by simp [Matrix.det_fin_two]⟩

/-- The subgroup of `SL₂(ℂ)` generated by the two displayed complex matrices. -/
def Gcomplex (q : ℂ) : Subgroup SL2Complex :=
  Subgroup.closure {Acomplex, Bcomplex q}

/-- Entrywise inclusion of rational special-linear matrices into complex matrices. -/
noncomputable def rationalToComplex : SL2 →* SL2Complex :=
  Matrix.SpecialLinearGroup.map (Rat.castHom ℂ)

/-- The entrywise inclusion is faithful. -/
theorem rationalToComplex_injective : Function.Injective rationalToComplex := by
  intro X Y h
  ext i j
  apply Rat.cast_injective (α := ℂ)
  exact congrArg (fun Z : SL2Complex => (Z : Matrix (Fin 2) (Fin 2) ℂ) i j) h

@[simp] theorem rationalToComplex_A : rationalToComplex A = Acomplex := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [rationalToComplex, Matrix.SpecialLinearGroup.map, A, lowerSL, lower, Acomplex]

@[simp] theorem rationalToComplex_B (q : ℚ) :
    rationalToComplex (B q) = Bcomplex (q : ℂ) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [rationalToComplex, Matrix.SpecialLinearGroup.map, B, upperSL, upper, Bcomplex]

/-- The image is exactly the subgroup generated by the displayed complex matrices. -/
theorem map_G_eq_Gcomplex (q : ℚ) :
    (G q).map rationalToComplex = Gcomplex (q : ℂ) := by
  rw [G, MonoidHom.map_closure, Set.image_pair]
  simp only [rationalToComplex_A, rationalToComplex_B, Gcomplex]

/-- The rational and complex generated matrix groups are isomorphic. -/
noncomputable def rationalComplexEquiv (q : ℚ) : G q ≃* Gcomplex (q : ℂ) :=
  ((G q).equivMapOfInjective rationalToComplex rationalToComplex_injective).trans
    (MulEquiv.subgroupCongr (map_G_eq_Gcomplex q))

/-- Abstract freeness is unchanged by the faithful entrywise inclusion. -/
theorem isFreeGroup_Gcomplex_iff (q : ℚ) :
    IsFreeGroup (Gcomplex (q : ℂ)) ↔ IsFreeGroup (G q) := by
  constructor
  · intro h
    letI := h
    exact IsFreeGroup.ofMulEquiv (rationalComplexEquiv q).symm
  · intro h
    letI := h
    exact IsFreeGroup.ofMulEquiv (rationalComplexEquiv q)

/-- For every integer denominator with absolute value greater than six, the
subgroup of `SL₂(ℂ)` generated by the actual displayed matrices is not a free group. -/
theorem twentyfour_complex_not_free (r : ℤ) (hr : 6 < |r|) :
    ¬ IsFreeGroup (Gcomplex ((24 : ℂ) / r)) := by
  have hn := twentyfour_not_free r hr
  have hc : (((24 : ℚ) / r : ℚ) : ℂ) = (24 : ℂ) / r := by push_cast; rfl
  rw [← hc]
  exact fun h => hn ((isFreeGroup_Gcomplex_iff ((24 : ℚ) / r)).mp h)

/-- The positive-denominator formulation. -/
theorem twentyfour_complex_not_free_of_gt_six (r : ℤ) (hr : 6 < r) :
    ¬ IsFreeGroup (Gcomplex ((24 : ℂ) / r)) := by
  apply twentyfour_complex_not_free r
  exact lt_of_lt_of_le hr (le_abs_self r)

/-- The equivalent natural-absolute-value formulation. -/
theorem twentyfour_complex_not_free_natAbs (r : ℤ) (hr : 6 < r.natAbs) :
    ¬ IsFreeGroup (Gcomplex ((24 : ℂ) / r)) := by
  apply twentyfour_complex_not_free r
  have h : (6 : ℤ) < (r.natAbs : ℤ) := by exact_mod_cast hr
  simpa only [Int.natCast_natAbs] using h

#print axioms rationalToComplex_injective
#print axioms rationalComplexEquiv
#print axioms twentyfour_complex_not_free

end TwentyFour
