import Mathlib.GroupTheory.FreeGroup.Reduce
import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Tactic

namespace TwentyFour

abbrev M2 := Matrix (Fin 2) (Fin 2) ℚ
abbrev SL2 := Matrix.SpecialLinearGroup (Fin 2) ℚ

def lower (x : ℚ) : M2 := !![1, 0; x, 1]
def upper (x : ℚ) : M2 := !![1, x; 0, 1]

def lowerSL (x : ℚ) : SL2 := ⟨lower x, by simp [lower, Matrix.det_fin_two]⟩
def upperSL (x : ℚ) : SL2 := ⟨upper x, by simp [upper, Matrix.det_fin_two]⟩
def A : SL2 := lowerSL 1
def B (q : ℚ) : SL2 := upperSL q

@[simp] theorem lowerSL_coe (x : ℚ) : ((lowerSL x : SL2) : M2) = lower x := rfl
@[simp] theorem upperSL_coe (x : ℚ) : ((upperSL x : SL2) : M2) = upper x := rfl

@[simp] theorem lowerSL_zero : lowerSL 0 = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [lowerSL, lower]
@[simp] theorem upperSL_zero : upperSL 0 = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [upperSL, upper]

theorem lowerSL_add (x y : ℚ) : lowerSL (x + y) = lowerSL x * lowerSL y := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [lowerSL, lower, Matrix.mul_apply, Fin.sum_univ_two]
theorem upperSL_add (x y : ℚ) : upperSL (x + y) = upperSL x * upperSL y := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [upperSL, upper, Matrix.mul_apply, Fin.sum_univ_two, add_comm]

def lowerHom : Multiplicative ℚ →* SL2 where
  toFun x := lowerSL x.toAdd
  map_one' := lowerSL_zero
  map_mul' x y := lowerSL_add _ _
def upperHom : Multiplicative ℚ →* SL2 where
  toFun x := upperSL x.toAdd
  map_one' := upperSL_zero
  map_mul' x y := upperSL_add _ _

@[simp] theorem lowerSL_zpow (x : ℚ) (n : ℤ) : lowerSL x ^ n = lowerSL (n * x) := by
  simpa [lowerHom, zsmul_eq_mul] using (map_zpow lowerHom (Multiplicative.ofAdd x) n).symm
@[simp] theorem upperSL_zpow (x : ℚ) (n : ℤ) : upperSL x ^ n = upperSL (n * x) := by
  simpa [upperHom, zsmul_eq_mul] using (map_zpow upperHom (Multiplicative.ofAdd x) n).symm

@[simp] theorem A_zpow_val (n : ℤ) : ((A ^ n : SL2) : M2) = lower n := by simp [A]
@[simp] theorem B_zpow_val (q : ℚ) (n : ℤ) : ((B q ^ n : SL2) : M2) = upper (n * q) := by simp [B]

def eval (q : ℚ) : FreeGroup Bool →* SL2 := FreeGroup.lift (fun b => if b then B q else A)

def HasRelation (q : ℚ) : Prop := ∃ w : FreeGroup Bool, w ≠ 1 ∧ eval q w = 1

/-- The matrix group in the question, generated by the two displayed matrices. -/
def G (q : ℚ) : Subgroup SL2 := Subgroup.closure {A, B q}

theorem hasRelation_not_injective {q : ℚ} (h : HasRelation q) : ¬ Function.Injective (eval q) := by
  rintro hinj
  rcases h with ⟨w, hw, he⟩
  exact hw (hinj (he.trans (map_one (eval q)).symm))

abbrev Syllable := Bool × ℤ

def word (l : List Syllable) : FreeGroup Bool := (l.map fun s => FreeGroup.of s.1 ^ s.2).prod

def matrixWord (q : ℚ) (l : List Syllable) : M2 :=
  (l.map fun s => if s.1 then upper (s.2 * q) else lower s.2).prod

def syllables : Bool → List ℤ → List Syllable
  | _, [] => []
  | b, e :: es => (b,e) :: syllables (!b) es

def matWord (q : ℚ) (b : Bool) (es : List ℤ) : M2 := matrixWord q (syllables b es)

def ReducedSyllables (l : List Syllable) : Prop :=
  l.IsChain (fun s t => s.1 ≠ t.1) ∧ ∀ s ∈ l, s.2 ≠ 0

@[simp] theorem word_nil : word [] = 1 := rfl
@[simp] theorem word_cons (s : Syllable) (l : List Syllable) :
    word (s :: l) = FreeGroup.of s.1 ^ s.2 * word l := by simp [word]
@[simp] theorem word_append (l k : List Syllable) : word (l ++ k) = word l * word k := by simp [word]

@[simp] theorem eval_word_val (q : ℚ) (l : List Syllable) :
    ((eval q (word l) : SL2) : M2) = matrixWord q l := by
  induction l with
  | nil => simp [matrixWord]
  | cons s l ih =>
    rcases s with ⟨b,n⟩
    simp only [word_cons, map_mul, map_zpow, Matrix.SpecialLinearGroup.coe_mul]
    rw [ih]
    cases b <;> simp [eval, matrixWord]

/-- Expansion of one nonzero integer-power syllable into signed letters. -/
def letters (s : Syllable) : List (Bool × Bool) :=
  List.replicate s.2.natAbs (s.1, decide (0 ≤ s.2))

def expandedWord (l : List Syllable) : List (Bool × Bool) := (l.map letters).flatten

theorem mk_letters (s : Syllable) : FreeGroup.mk (letters s) = FreeGroup.of s.1 ^ s.2 := by
  rcases s with ⟨b,n⟩
  cases n with
  | ofNat n =>
    simp [letters, FreeGroup.of, FreeGroup.pow_mk, List.flatten_replicate_singleton]
  | negSucc n =>
    simp [letters, zpow_negSucc, FreeGroup.of, FreeGroup.pow_mk,
      List.flatten_replicate_singleton, FreeGroup.invRev]

theorem mk_expandedWord (l : List Syllable) : FreeGroup.mk (expandedWord l) = word l := by
  induction l with
  | nil => rfl
  | cons s l ih =>
    simpa [expandedWord, ← FreeGroup.mul_mk, mk_letters] using congrArg (fun w => FreeGroup.of s.1 ^ s.2 * w) ih

theorem expandedWord_reduced {l : List Syllable} (h : ReducedSyllables l) :
    FreeGroup.IsReduced (expandedWord l) := by
  have hn : [] ∉ l.map letters := by
    intro hem
    obtain ⟨s, hs, he⟩ := List.mem_map.mp hem
    exact h.2 s hs (by simpa [letters] using he)
  rw [expandedWord, FreeGroup.IsReduced, List.isChain_flatten hn]
  constructor
  · intro k hk
    obtain ⟨s, hs, rfl⟩ := List.mem_map.mp hk
    exact List.isChain_replicate_of_rel _ (fun _ => rfl)
  · rw [List.isChain_map]
    apply h.1.imp
    intro s t hst x hx y hy hxy
    have hxs : x = (s.1, decide (0 ≤ s.2)) :=
      List.eq_of_mem_replicate (List.mem_of_mem_getLast? hx)
    have hyt : y = (t.1, decide (0 ≤ t.2)) :=
      List.eq_of_mem_replicate (List.mem_of_mem_head? hy)
    exact False.elim (hst (by simpa [hxs, hyt] using hxy))

theorem expandedWord_ne_nil {l : List Syllable} (h : ReducedSyllables l) (hn : l ≠ []) :
    expandedWord l ≠ [] := by
  cases l with
  | nil => exact False.elim (hn rfl)
  | cons s l =>
    intro he
    change letters s ++ expandedWord l = [] at he
    have hs : letters s = [] := (List.append_eq_nil_iff.mp he).1
    exact h.2 s (by simp) (by simpa [letters] using hs)

theorem word_ne_one {l : List Syllable} (h : ReducedSyllables l) (hn : l ≠ []) : word l ≠ 1 := by
  intro he
  have hred := (expandedWord_reduced h).reduce_eq
  have heq := congrArg FreeGroup.toWord ((mk_expandedWord l).trans he)
  simp only [FreeGroup.toWord_mk, FreeGroup.toWord_one, hred] at heq
  exact expandedWord_ne_nil h hn heq

def invSyllables (l : List Syllable) : List Syllable := l.reverse.map (fun s => (s.1, -s.2))

def relationSyllables (l : List Syllable) : List Syllable :=
  l ++ [(false,1)] ++ invSyllables l ++ [(false,1)] ++
    l ++ [(false,-1)] ++ invSyllables l ++ [(false,-1)]

theorem word_invSyllables (l : List Syllable) : word (invSyllables l) = (word l)⁻¹ := by
  induction l with
  | nil => simp [invSyllables]
  | cons s l ih =>
    have he : invSyllables (s :: l) = invSyllables l ++ [(s.1, -s.2)] := by
      simp [invSyllables]
    rw [he, word_append, ih, word_cons]
    simp [word, mul_inv_rev]

theorem relationSyllables_ne_nil (l : List Syllable) : relationSyllables l ≠ [] := by
  simp [relationSyllables]

theorem triangular_conjugate_commutes (W : SL2) (ht : (W : M2) 0 1 = 0) :
    (W * A * W⁻¹) * A = A * (W * A * W⁻¹) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [A, lowerSL, lower, Matrix.SpecialLinearGroup.coe_mul,
      Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two,
      Matrix.mul_apply, Fin.sum_univ_two, ht] <;> ring

/-- The displayed syllable relation evaluates to the identity matrix. -/
theorem triangular_relation_eval (q : ℚ) (l : List Syllable)
    (htri : matrixWord q l 0 1 = 0) : eval q (word (relationSyllables l)) = 1 := by
  have ht : ((eval q (word l) : SL2) : M2) 0 1 = 0 := by rwa [eval_word_val]
  have hc := triangular_conjugate_commutes (eval q (word l)) ht
  have hr : word (relationSyllables l) =
      (word l * FreeGroup.of false * (word l)⁻¹) * FreeGroup.of false *
      (word l * FreeGroup.of false * (word l)⁻¹)⁻¹ * (FreeGroup.of false)⁻¹ := by
    simp [relationSyllables, word_append, word_invSyllables, mul_inv_rev, mul_assoc]
  rw [hr]
  simp only [map_mul, map_inv, eval, FreeGroup.lift_apply_of, Bool.false_eq_true, ↓reduceIte]
  change (eval q (word l) * A * (eval q (word l))⁻¹) * A *
    (eval q (word l) * A * (eval q (word l))⁻¹)⁻¹ * A⁻¹ = 1
  rw [hc]
  simp [mul_assoc]

/-- A fully explicit nontrivial free-group relation obtained from a triangular word. -/
theorem triangular_hasRelation (q : ℚ) (l : List Syllable)
    (hred : ReducedSyllables (relationSyllables l))
    (htri : matrixWord q l 0 1 = 0) : HasRelation q := by
  exact ⟨word (relationSyllables l), word_ne_one hred (relationSyllables_ne_nil l),
    triangular_relation_eval q l htri⟩

theorem fiveBlock_hasRelation (q : ℚ) (e1 e2 e3 e4 e5 : ℤ)
    (h1 : e1 ≠ 0) (h2 : e2 ≠ 0) (h3 : e3 ≠ 0) (h4 : e4 ≠ 0) (h5 : e5 ≠ 0)
    (htri : (upper (e1*q) * lower e2 * upper (e3*q) * lower e4 * upper (e5*q)) 0 1 = 0) :
    HasRelation q := by
  let l : List Syllable := [(true,e1),(false,e2),(true,e3),(false,e4),(true,e5)]
  apply triangular_hasRelation q l
  · simp [l, relationSyllables, invSyllables, ReducedSyllables, List.isChain_cons_cons,
      h1, h2, h3, h4, h5]
  · simpa [l, matrixWord, mul_assoc] using htri

/-- For a unipotent triangular word the shorter ordinary commutator suffices. -/
def commutatorSyllables (l : List Syllable) : List Syllable :=
  l ++ [(false,1)] ++ invSyllables l ++ [(false,-1)]

theorem unipotent_relation_eval (q : ℚ) (l : List Syllable) (z : ℚ)
    (hmat : matrixWord q l = lower z) :
    eval q (word (commutatorSyllables l)) = 1 := by
  have hw : eval q (word l) = lowerSL z := by
    apply Subtype.ext
    exact (eval_word_val q l).trans hmat
  have hc : lowerSL z * A = A * lowerSL z := by
    simp only [A, ← lowerSL_add]
    congr 1
    ring
  have he : word (commutatorSyllables l) =
      word l * FreeGroup.of false * (word l)⁻¹ * (FreeGroup.of false)⁻¹ := by
    simp [commutatorSyllables, word_invSyllables, mul_assoc]
  rw [he]
  simp only [map_mul, map_inv]
  rw [hw]
  have ha : eval q (FreeGroup.of false) = A := by simp [eval]
  rw [ha, hc]
  simp [mul_assoc]

theorem fiveBlock_unipotent_certificate (q : ℚ) (e1 e2 e3 e4 e5 : ℤ) (z : ℚ)
    (h1 : e1 ≠ 0) (h2 : e2 ≠ 0) (h3 : e3 ≠ 0) (h4 : e4 ≠ 0) (h5 : e5 ≠ 0)
    (hmat : upper (e1*q) * lower e2 * upper (e3*q) * lower e4 * upper (e5*q) = lower z) :
    ∃ l : List Syllable, l.length = 12 ∧ ReducedSyllables l ∧
      word l ≠ 1 ∧ eval q (word l) = 1 := by
  let w : List Syllable := [(true,e1),(false,e2),(true,e3),(false,e4),(true,e5)]
  have hred : ReducedSyllables (commutatorSyllables w) := by
    simp [w, commutatorSyllables, invSyllables, ReducedSyllables, List.isChain_cons_cons,
      h1, h2, h3, h4, h5]
  refine ⟨commutatorSyllables w, ?_, hred, word_ne_one hred ?_, ?_⟩
  · simp [w, commutatorSyllables, invSyllables]
  · simp [commutatorSyllables]
  · apply unipotent_relation_eval q w z
    simpa [w, matrixWord, mul_assoc] using hmat

theorem fiveBlock_unipotent_hasRelation (q : ℚ) (e1 e2 e3 e4 e5 : ℤ) (z : ℚ)
    (h1 : e1 ≠ 0) (h2 : e2 ≠ 0) (h3 : e3 ≠ 0) (h4 : e4 ≠ 0) (h5 : e5 ≠ 0)
    (hmat : upper (e1*q) * lower e2 * upper (e3*q) * lower e4 * upper (e5*q) = lower z) :
    HasRelation q := by
  obtain ⟨l, _, _, hn, he⟩ := fiveBlock_unipotent_certificate q e1 e2 e3 e4 e5 z h1 h2 h3 h4 h5 hmat
  exact ⟨word l, hn, he⟩

@[simp] theorem B_neg (q : ℚ) : B (-q) = (B q)⁻¹ := by
  simpa [B] using (upperSL_zpow q (-1)).symm

def negateGenerator : FreeGroup Bool →* FreeGroup Bool :=
  FreeGroup.lift (fun b => if b then (FreeGroup.of true)⁻¹ else FreeGroup.of false)

theorem negateGenerator_involutive : Function.Involutive negateGenerator := by
  have he : negateGenerator.comp negateGenerator = MonoidHom.id (FreeGroup Bool) := by
    apply FreeGroup.ext_hom
    intro b
    cases b <;> simp [negateGenerator]
  intro w
  exact DFunLike.congr_fun he w

theorem eval_negateGenerator (q : ℚ) (w : FreeGroup Bool) :
    eval q (negateGenerator w) = eval (-q) w := by
  have he : (eval q).comp negateGenerator = eval (-q) := by
    apply FreeGroup.ext_hom
    intro b
    cases b <;> simp [negateGenerator, eval]
  exact DFunLike.congr_fun he w

theorem hasRelation_neg {q : ℚ} (h : HasRelation (-q)) : HasRelation q := by
  obtain ⟨w, hw, he⟩ := h
  refine ⟨negateGenerator w, ?_, ?_⟩
  · intro hz
    apply hw
    have hi := negateGenerator_involutive w
    rw [hz, map_one] at hi
    exact hi.symm
  · rw [eval_negateGenerator]
    exact he

theorem hasRelation_neg_iff (q : ℚ) : HasRelation (-q) ↔ HasRelation q := by
  constructor
  · exact hasRelation_neg
  · intro h
    apply hasRelation_neg
    simpa using h

theorem range_eval (q : ℚ) : (eval q).range = G q := by
  rw [eval, FreeGroup.range_lift_eq_closure, G]
  congr 1
  ext x
  simp [Bool.exists_bool, eq_comm, or_comm]

theorem generators_noncommute (q : ℚ) (hq : q ≠ 0) : A * B q ≠ B q * A := by
  intro he
  have he00 := congrArg (fun W : SL2 => (W : M2) 0 0) he
  have hz : q = 0 := by
    simp [A, B, lowerSL, upperSL, lower, upper, Matrix.mul_apply, Fin.sum_univ_two] at he00
    linarith
  exact hq hz

end TwentyFour
