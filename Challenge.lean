import Mathlib.Data.Complex.Basic
import Mathlib.GroupTheory.FreeGroup.IsFreeGroup
import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Tactic

/-!
An independent, Mathlib-only specification. This file states the mathematical
target as a proposition; it does not assume the target as an axiom or use `sorry`.
The implementation proof is checked against this proposition in Solution.lean.
-/
namespace Challenge

abbrev SL2 := Matrix.SpecialLinearGroup (Fin 2) ℚ

def A : SL2 := ⟨!![1, 0; 1, 1], by simp [Matrix.det_fin_two]⟩
def B (q : ℚ) : SL2 := ⟨!![1, q; 0, 1], by simp [Matrix.det_fin_two]⟩
def generatedGroup (q : ℚ) : Subgroup SL2 := Subgroup.closure {A, B q}

/-- For every integer denominator with absolute value greater than six,
the two displayed rational matrices generate an abstractly non-free group. -/
def MainStatement : Prop := ∀ r : ℤ, 6 < |r| →
  ¬ IsFreeGroup (generatedGroup ((24 : ℚ) / r))

/-- The separate relation-number statement uses the genuine free group on two
formal generators, and the canonical group homomorphism into SL(2, ℚ). -/
def RelationStatement : Prop := ∀ r : ℤ, 6 < |r| →
  ∃ w : FreeGroup Bool, w ≠ 1 ∧
    FreeGroup.lift (fun b : Bool => if b then B ((24 : ℚ) / r) else A) w = 1

/-- The length here counts nonzero, alternating generator-power syllables,
not letters obtained by expanding potentially large exponents. -/
def BoundedStatement : Prop := ∀ r : ℤ, 6 < |r| →
  ∃ l : List (Bool × ℤ),
    (l.IsChain (fun s t => s.1 ≠ t.1) ∧ ∀ s ∈ l, s.2 ≠ 0) ∧
    l ≠ [] ∧ l.length ≤ 64 ∧
    (l.map (fun s => FreeGroup.of s.1 ^ s.2)).prod ≠ 1 ∧
    FreeGroup.lift (fun b : Bool => if b then B ((24 : ℚ) / r) else A)
      (l.map (fun s => FreeGroup.of s.1 ^ s.2)).prod = 1


/-- An independently stated complex-matrix version of the same generated group. -/
abbrev ComplexSL2 := Matrix.SpecialLinearGroup (Fin 2) ℂ

def ComplexA : ComplexSL2 := ⟨!![1, 0; 1, 1], by simp [Matrix.det_fin_two]⟩
def ComplexB (q : ℂ) : ComplexSL2 := ⟨!![1, q; 0, 1], by simp [Matrix.det_fin_two]⟩
def generatedComplexGroup (q : ℂ) : Subgroup ComplexSL2 :=
  Subgroup.closure {ComplexA, ComplexB q}

/-- The subgroup generated by the displayed actual complex matrices is not abstractly free. -/
def ComplexMainStatement : Prop := ∀ r : ℤ, 6 < |r| →
  ¬ IsFreeGroup (generatedComplexGroup ((24 : ℂ) / r))


/-- Alternating integer powers, starting with the upper-triangular generator. -/
def alternatingSyllables : Bool → List ℤ → List (Bool × ℤ)
  | _, [] => []
  | b, e :: es => (b, e) :: alternatingSyllables (!b) es

def alternatingMatrixWord (q : ℚ) (es : List ℤ) : Matrix (Fin 2) (Fin 2) ℚ :=
  ((alternatingSyllables true es).map (fun s =>
    if s.1 then !![1, (s.2 : ℚ) * q; 0, 1] else !![1, 0; (s.2 : ℚ), 1])).prod

/-- Every denominator above the explicit finite cutoff has a triangular word
of one, three, or five alternating nonzero powers, starting and ending with B. -/
def TwoStepStatement : Prop := ∀ r : ℤ, 17 < |r| →
  ∃ es : List ℤ, (∀ e ∈ es, e ≠ 0) ∧
    (es.length = 1 ∨ es.length = 3 ∨ es.length = 5) ∧
    alternatingMatrixWord ((24 : ℚ) / r) es 0 1 = 0

end Challenge
